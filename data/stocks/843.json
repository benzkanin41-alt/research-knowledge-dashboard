) ส าหรับหุ้นที่ให้ผลตอบแทนที่คาดหวังรวมส่วนต่างของมูลค่าเหมาะสมกับราคาในตลาดและผลตอบแทนเงินปันผล ระหว่าง -10% ถึง +15%\n\n(3) ขาย (SELL) ส าหรับหุ้นที่ปัจจัยพื้นฐานไม่ดี และ/หรือ ให้ผลตอบแทนที่คาดหวังรวมส่วนต่างของมูลค่าเหมาะสมกับราคาในตลาด ติดลบมากกว่า 10% ขึ้นไป","item_type":"ผลประกอบการ","line_start":1,"line_end":800,"confidence":0.98,"source_name":"7_260803080142_JFMGC__5df59334.txt","stock_scope":"source","scope_label":"เฉพาะ JFMGC","cited_sources":[]}],"sources":[{"name":"7_260803080142_JFMGC__5df59334.txt","report_date":"2026-08-04","item_count":1,"first_line":1,"last_line":800}],"metric_groups":[{"key":"FY-2027:revenue","period_key":"FY-2027","period_kind":"year","period_label":"ปี 2570F","period_year":2027,"period_quarter":5,"metric_code":"revenue","metric_label":"รายได้","scale":"million","currency":"THB","unit_label":"THB ล้าน","status":"awaiting","actual":null,"estimate_count":1,"estimate_median":228903.0,"estimate_min":228903.0,"estimate_max":228903.0,"rows":[{"analyst":"Yuanta Securities","estimate":228903.0,"estimate_low":183442.0,"estimate_high":183442.0,"estimate_date":"2026-08-04","source_name":"7_260803080142_JFMGC__5df59334.txt","source_line":113,"reason":"ตารางต้นฉบับ Revenue: Revenue 187,249 183,442 192,330 228,903","actual":null,"delta":null,"delta_pct":null,"absolute_error":null,"absolute_error_pct":null,"currency":"THB","scale":"million","comparable_to_actual":true,"exact_source_verified":true,"period_integrity":"exact-source","semantic_integrity":"semantic-evidence-consistent","forecast_reason":"ตารางต้นฉบับ Revenue: Revenue 187,249 183,442 192,330 228,903","symbol_period_value_ownership_v59":"preview"}],"coverage_engine":"all-company-v17-final-quality","included_brokers":["Yuanta Securities"],"mixed_currency":false,"covered_without_number":[],"coverage_broker_count":1,"coverage_release":"2026-07-23-v47-actual-release-guard","exact_reconciliation":true,"source_attribution_recovery":true,"fundamental_integrity":true,"semantic_quarantine_cou