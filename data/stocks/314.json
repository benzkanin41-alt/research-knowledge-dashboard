น risk/reward ของการถือข้ามงบ เพราะหุ้นวิ่งแรงก่อนงบแล้วและอาจเกิด sell-on-fact ได้หาก F4Q26 guidance หรือ FY2027 EPS ไม่ยืนยัน supercycle [แหล่ง: MICRON01 note, 23 Jun 2026]","item_type":"ประมาณการ","line_start":201,"line_end":206,"confidence":0.98,"source_name":"research_summary.md","stock_scope":"excerpt","scope_label":"เฉพาะ MICRON01","cited_sources":["MICRON01_23062026.pdf"]},{"id":1785,"stock_id":314,"source_document_id":730,"report_date":"2026-06-23","heading":"MICRON01 — MICRON01_-_Preview_Micron_F3Q26-BLS-23_Jun_2569__f29043a6","content":"Bloomberg Consensus คาด Gross Margin F3Q26 ที่ 81.8% เพิ่มขึ้นจาก 74.9% ใน F2Q26 และ\n\nระดับ 80% กลาง ๆ ท าให้แนวโน้ม Gross Margin ใน F4Q26 และปีหน้าเป็นหนึ่งในประเด็นส าคัญที่ต้องจับ\n\nมุมมองต่อ MICRON01 ยังเป็นบวกจาก AI Memory Supercycle แต่ต้องระวัง Sell on Fact\n\nBloomberg Consensus คาดรายได้ F3Q26 ของ Micron ที่ $35.4bn เติบโต 280.9%YoY และเพิ่มขึ้น\n\nBloomberg Consensus คาดรายได้จาก DRAM ใน F3Q26 ที่ $27.4bn เติบโต 287.4%YoY และเพิ่มขึ้น\n\nBloomberg Consensus คาดรายได้ NAND ใน F3Q26 ที่ $7.7bn เติบโต 255.9%YoY และเพิ่มขึ้นราว\n\n+60.9% ใน 1 เดือนหลังงบ โดยรอบนั้นมีทั้ง EPS Surprise, Guidance Surprise และ Gross Margin\n\nตาราง sensitivity ราคาเป้าหมาย MICRON01","item_type":"ผลประกอบการ","line_start":1,"line_end":704,"confidence":0.98,"source_name":"MICRON01_-_Preview_Micron_F3Q26-BLS-23_Jun_2569__f29043a6.txt","stock_scope":"source","scope_label":"เฉพาะ MICRON01","cited_sources":[]}],"sources":[{"name":"research_summary.md","report_date":"2026-06-24","item_count":1,"first_line":201,"last_line":206},{"name":"MICRON01_-_Preview_Micron_F3Q26-BLS-23_Jun_2569__f29043a6.txt","report_date":"2026-06-23","item_count":1,"first_line":1,"last_line":704}],"metric_groups":[{"key":"FY-2027:revenue","period_key":"FY-2027","period_kind":"year","period_label":"ปี 2570F","period_year":2027,"period_quarter":5,"metric_code":"revenue","metric_label":"รายได้","scale":"million","currency":"USD","unit_label":"USD ล้าน","status":"awaiting