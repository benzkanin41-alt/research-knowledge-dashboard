,"source_text":"(RMB mn) 2025A 2026A 2027F 2028F 2029F  | Sales 23,511 24,401 25,014 25,879 26,871","line_start":495,"confidence":0.97,"analyst":"Yuanta Securities","source_name":"Alpha_Abroad_-_Want_Want_China_151_HK_-YT-3_Jul_2569__d0a734a3.txt"},{"id":33179,"stock_id":598,"analyst_id":5,"source_document_id":2136,"report_date":"2026-07-03","period_raw":"2029F","metric_code":"net_profit","observation_type":"estimate","value_low":4339.0,"value_high":4339.0,"currency":null,"scale":"million","source_text":"(RMB mn) 2025A 2026A 2027F 2028F 2029F  | Net profit 4,336 3,837 4,339 4,590 5,046","line_start":469,"confidence":0.97,"analyst":"Yuanta Securities","source_name":"Alpha_Abroad_-_Want_Want_China_151_HK_-YT-3_Jul_2569__d0a734a3.txt"},{"id":33178,"stock_id":598,"analyst_id":5,"source_document_id":2136,"report_date":"2026-07-03","period_raw":"2028F","metric_code":"net_profit","observation_type":"estimate","value_low":3837.0,"value_high":3837.0,"currency":null,"scale":"million","source_text":"(RMB mn) 2025A 2026A 2027F 2028F 2029F  | Net profit 4,336 3,837 4,339 4,590 5,046","line_start":469,"confidence":0.97,"analyst":"Yuanta Securities","source_name":"Alpha_Abroad_-_Want_Want_China_151_HK_-YT-3_Jul_2569__d0a734a3.txt"},{"id":33177,"stock_id":598,"analyst_id":5,"source_document_id":2136,"report_date":"2026-07-03","period_raw":"2027F","metric_code":"net_profit","observation_type":"estimate","value_low":4336.0,"value_high":4336.0,"currency":null,"scale":"million","source_text":"(RMB mn) 2025A 2026A 2027F 2028F 2029F  | Net profit 4,336 3,837 4,339 4,590 5,046","line_start":469,"confidence":0.97,"analyst":"Yuanta Securities","source_name":"Alpha_Abroad_-_Want_Want_China_151_HK_-YT-3_Jul_2569__d0a734a3.txt"}],"comparisons":[],"knowledge":[{"id":13472,"stock_id":598,"source_document_id":4142,"report_date":"2026-08-03","heading":"WANT — บทวิเคราะห์รายบริษัท: Alpha Abroad - Want Want China-YT-3 August 2026","content":"ยอดขายผ่านช่องทางการค้าแบบดั้งเดิม (Traditional Channel) ซึ่งมีสัดส่วนรายได้กว่า 50% และ\n\nกำไรสุทธิมากกว่า 60% ลดลงในระดับเลขสองหลัก YoY 2) ค่าใช้จ่ายในการดำเนินงานเพิ่มขึ้นใน\n\nด้านการโฆษณาและส่งเสริมการขาย (A&P) รวมถึงค่าใช้จ่ายพนักงานเพิ่มขึ้น 3) กำไรสุทธิลดลง\n\nเปลี่ยนแปลง ฝ่ายบริหารระบุว่า การปรับตัวลงอย่างมีนัยสำคัญของยอดขายผ่านช่องทางการค้า\n\nฝ่ายบริหารยังสังเกตเห็นความไม่เป็นระเบียบของระบบการกระจายสินค้า โดยคาดว่าเกิดจากร้าน\n\nฝ่ายบริหารคาดว่าการหดตัวของกำไรสุทธิในช่วง FY2H27F จะลดลงเมื่อเทียบกับ FY1H27 จาก\n\nเราปรับลดคำแนะนำหุ้นเป็น HOLD เนื่องจากแนวโน้มที่บริษัทเคยให้ไว้ก่อนหน้านี้ถูกหักล้างภายใน\n\nเวลาเพียงหนึ่งเดือน โดยก่อนหน้านี้ตลาดคาดกำไรสุทธิ FY2027 จะเติบโต 7% YoY ขณะที่ผล\n\nกระทบต่อความเชื่อมั่นของนักลงทุน ก่อนหน้านี้ เราคาดว่า Want Want จะกลับมาเติบโตได้ในปีนี้\n\nข้อมูลหรือเนื้อหา ความเห็น ข่าว บทวิเคราะห์ บทวิจัย ข้อความ ราคา การคาดการณ์ การประเมิน และ/หรืออื่นใดในเอกสารที่ระบุในรายงาน","item_type":"ผลประกอบการ","line_start":1,"line_end":877,"confidence":0.98,"source_name":"Alpha Abroad - Want Want China-YT-3 August 2026.pdf","stock_scope":"source","scope_label":"เฉพาะ WANT","cited_sources":[]},{"id":13570,"stock_id":598,"source_document_id":4212,"report_date":"2026-08-03","heading":"WANT — บทวิเคราะห์รายบริษัท: Want Want China Original Research-YT-3 August 2026","content":"Profit warning catches the market off guard: Want Want issued FY1Q27\n\ndistributor exits, due to rising operating costs and declining profits.\n\nMgmt observed chaotic channel distribution (likely due to\n\nDowngrade our investment rating to HOLD-OPF from Buy and drop our target price to HK$3.45\n\nWe thus derive a P/E-based target price of HK$3.45.\n\nWant Want China (151 HK) – Three-year recommendation and target price history\n\nNotes: A = price not adjusted for stock or cash dividends; B = unadjusted target price; C = target price adjusted for stock & cash dividends.\n\nUnder Review: We actively follow the company, although our estimates, rating and target price are under review.\n\nRestricted: The rating and target price have been suspended temporarily to comply with applicable regulations and/or Yuanta policies.\n\nNote: Yuanta research coverage with a Target Price is based on an investment period of 12 months.","item_type":"ประมาณการ","line_start":1,"line_end":1046,"confidence":0.98,"source_name":"Want Want China Original Research-YT-3 August 2026.pdf","stock_scope":"source","scope_label":"เฉพาะ WANT","cited_sources":[]},{"id":5058,"stock_id":598,"source_document_id":2136,"report_date":"2026-07-03","heading":"WANT — Alpha_Abroad_-_Want_Want_China_151_HK_-YT-3_Jul_2569__d0a734a3","content":"รายได้ในช่วง FY2H26 เติบโต 5.2% YoY เร่งตัวจาก 2.1% YoY ในช่วง FY1H26 โดยได้รับ\n\nช่วง FY1H26 ยอดขายในช่องทาง Specialty Snack Retail และ Emerging Channel ในช่วง\n\nYoY ฝายบริหารได้ล็อกราคานมผงนําเข้าล่วงหน้าไว้ 6-9 เดือน และคาดว่าต้นทุนจะกลับสู่\n\nลดลง 13% YoY นับตังแต่ต้นป (YTD) ด้วยเหตุนี บริษัทคาดว่าอัตรากําไรขันต้นจะเริมฟ น\n\nFY1Q27 ยังอยู่ในระดับปานกลาง และแนวโน้มยอดขายยังมีความท้าทาย แต่ตังเปารักษา\n\nFigure 1: Want Want’s cost of goods sold - breakdown and spot price changes\n\n► เราใช้ค่า P/E 3 ปของ Want Want เปนเกณฑ์มาตรฐานในการประเมินมูลค่า โดยลดอัตราส่วนการประเมินมูลค่าลง\n\nFigure 4: Want Want forward P/E Figure 5: 12-month forward looking P/B band chart\n\nเรายังคงแนะนํา \"ซือ\" สําหรับหุ้น Want Want และปรับลดราคาเปาหมายลงเหลือ 5.17 ดอลลาร์ฮ่องกง จาก 5.80\n\nข้อมูลหรือเนือหา ความเห็น ข่าว บทวิเคราะห์ บทวิจัย ข้อความ ราคา การคาดการณ์ การประเมิน และ/หรืออืนใดในเอกสารทีระบุในรายงาน","item_type":"ประมาณการ","line_start":1,"line_end":581,"confidence":0.98,"source_name":"Alpha_Abroad_-_Want_Want_China_151_HK_-YT-3_Jul_2569__d0a734a3.txt","stock_scope":"source","scope_label":"เฉพาะ WANT","cited_sources":[]}],"sources":[{"name":"Alpha Abroad - Want Want China-YT-3 August 2026.pdf","report_date":"2026-08-03","item_count":1,"first_line":1,"last_line":877},{"name":"Want Want China Original Research-YT-3 August 2026.pdf","report_date":"2026-08-03","item_count":1,"first_line":1,"last_line