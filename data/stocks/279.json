ําทีตํากว่าคาด ซึงเปนผลจากสัดส่วนการปองกันความเสียง\n\nเราได้ปรับประมาณการกําไรสําหรับป 2029 โดยอิงจากประมาณการกําไรทีปรับปรุงใหม่ ซึง CTFJ คาดว่าจะมีกําไรสุทธิ\n\nข้อมูลหรือเนือหา ความเห็น ข่าว บทวิเคราะห์ บทวิจัย ข้อความ ราคา การคาดการณ์ การประเมิน และ/หรืออืนใดในเอกสารทีระบุในรายงาน","item_type":"ผลประกอบการ","line_start":1,"line_end":328,"confidence":0.98,"source_name":"Alpha_Abroad_Chow_Tai_Fook_Jewellery_1929_HK-YT-2026-06-18__73e75a11.txt","stock_scope":"source","scope_label":"เฉพาะ CHOW","cited_sources":[]}],"sources":[{"name":"Alpha_Abroad_Chow_Tai_Fook_Jewellery_1929_HK-YT-2026-06-18__73e75a11.txt","report_date":"2026-06-18","item_count":1,"first_line":1,"last_line":328}],"metric_groups":[{"key":"FY-2029:npm","period_key":"FY-2029","period_kind":"year","period_label":"ปี 2572F","period_year":2029,"period_quarter":5,"metric_code":"npm","metric_label":"อัตรากำไรสุทธิ (NPM)","scale":"percent","currency":null,"unit_label":"%","status":"awaiting","actual":null,"estimate_count":1,"estimate_median":11.1,"estimate_min":11.1,"estimate_max":11.1,"rows":[{"analyst":"Yuanta Securities","estimate":11.1,"estimate_low":10.0,"estimate_high":10.0,"estimate_date":"2026-06-18","source_name":"Alpha_Abroad_Chow_Tai_Fook_Jewellery_1929_HK-YT-2026-06-18__73e75a11.txt","source_line":274,"reason":"Year to Mar 2025A 2026A 2027F 2028F 2029F | Net profit margin 6.7 9.6 10.0 10.9 11.1 เราได้ปรับประมาณการกําไรสําหรับป 2029 โดยอิงจากประมาณการกําไรทีปรับปรุงใหม่ ซึง CTFJ คาดว่าจะมีกําไรสุทธิ ข้อมูลหรือเนือหา ความเห็น ข่าว บทวิเคราะห์ บทวิจัย ข้อความ ราคา การคาดการณ์ การประเมิน และ/หรืออืนใดในเอกสารทีระบุในรายงาน","actual":null,"delta":null,"delta_pct":null,"absolute_error":null,"absolute_error_pct":null,"currency":null,"scale":"percent","comparable_to_actual":true,"period_integrity":"nearest-period-match","semantic_integrity":"semantic-evidence-consistent","forecast_reason":"Year to Mar 2025A 2026A 2027F 2028F 2029F | Net profit margin 6.7 9.6 10.0 10.9 11.1 เราได้ปรับประมาณการกําไรสําหร