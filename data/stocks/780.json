xt"},{"id":67557,"stock_id":780,"analyst_id":16,"source_document_id":3916,"report_date":"2026-07-30","period_raw":"2Q26","metric_code":"revenue","observation_type":"actual","value_low":19500.0,"value_high":19500.0,"currency":"EUR","scale":"million","source_text":"Bank of America · LVMH reported 2Q26 revenue of €19.5bn, +3% at constant currency, which was inline","line_start":51,"confidence":0.9,"analyst":"Bank of America","source_name":"20260728_LVMH__532c9e25.txt"}],"comparisons":[],"knowledge":[{"id":12824,"stock_id":780,"source_document_id":3916,"report_date":"2026-07-30","heading":"LVMH — บทวิเคราะห์รายบริษัท: 20260728_LVMH","content":"LVMH reported 2Q26 revenue of €19.5bn, +3% at constant currency, which was inline\n\n12-18 months in luxury, LVMH should benefit from its\n\nLVMH reported 2Q26 revenue of €19,524m, growing +3% on an organic basis,\n\nExhibit 3: We show below our estimates for LVMH F&L revenue growth trends by nationality, in 1Q24 to 1Q26\n\nWe show below the revenue performance at F&L, by region as reported by LVMH in the\n\nLVMH Fashion & Leather Goods revenue growth by region, cFX, BofA estimates.\n\nExhibit 13: We expect LVMH organic group revenue to continues its progressive recovery\n\nLVMH reported 1H26 EBIT €8,691m, which was down -4% yoy, but was 1-3% ahead of\n\nLVMH reported a group 1H26 EBIT margin of 22.5%, which was down 10bps vs last\n\nExhibit 17: LVMH 1H26 group gross margin expands 30bps YoY, but is offset by 40bps of","item_type":"ผลประกอบการ","line_start":1,"line_end":2609,"confidence":0.98,"source_name":"20260728_LVMH__532c9e25.txt","stock_scope":"source","scope_label":"เฉพาะ LVMH","cited_sources":[]},{"id":12961,"stock_id":780,"source_document_id":4013,"report_date":"2026-07-30","heading":"LVMH — บทวิเคราะห์รายบริษัท: 20260728_LVMH_TH","content":"LVMH รายงานรายได้ 2Q26 ที่ €19.5bn เติบโต +3% cFX ตามคาด และเร่งขึ้น +2ppt จาก\n\nซึ่งมีแนวโน้มต่อเนื่องเข้าสู่ 2H26 LVMH ควบคุมต้นทุนได้ดีมาก โดยต้นทุนดำเนินงานเพิ่ม +2%\n\nLVMH ระบุว่าแรงกดดันจากตะวันออกกลางกระทบรายได้กลุ่ม 1ppt และกระทบรายได้แผนก\n\nเราคาดรายได้ออร์แกนิกของกลุ่ม LVMH เติบโต +3% ในปี 2026\n\nLVMH รายงาน EBIT 1H26 ที่ €8,691m ลดลง -4% yoy แต่สูงกว่าฉันทามติและคาดการณ์\n\nExhibit 17: อัตรากำไรขั้นต้นของกลุ่ม LVMH ใน 1H26 เพิ่มขึ้น 30bps YoY แต่ถูกหักล้างด้วยแรงกดดัน\n\nไว้ในกลุ่มนาฬิกา; ธุรกิจอื่นของ Richemont, ยอดค้าปลีกแบรนด์ Moncler, Burberry SSSG, ยอดขาย DTC ของแบรนด์ Zegna และ LVMH F&L\n\nรูปที่ 45: ประมาณการ EBIT ปี 2026 ของ LVMH ถูกปรับลดลงมากกว่า\n\nใน US การขายปลีกและ/หรือการจัดจำหน่ายรายงานนี้อาจทำได้เฉพาะในรัฐที่หลักทรัพย์เหล่านี้ได้รับการยกเว้นจากการจดทะเบียนหรือมีคุณสมบัติสำหรับการขาย: LVMH.\n\nBofA S หรือบริษัทในเครือคาดว่าจะได้รับหรือตั้งใจที่จะขอค่าตอบแทนสำหรับบริการวาณิชธนกิจจากผู้ออกรายนี้หรือบริษัทในเครือของผู้ออกภายในสามเดือนข้างหน้า: LVMH.","item_type":"ผลประกอบการ","line_start":1,"line_end":8778,"confidence":0.98,"source_name":"20260728_LVMH_TH.pdf","stock_scope":"source","scope_label":"เฉพาะ LVMH","cited_sources":[]},{"id":13060,"stock_id":780,"source_document_id":4015,"report_date":"2026-07-30","heading":"LVMH — ภาพอุตสาหกรรม: 20260714_Luxury Goods_TH","content":"LVMH (27 กรกฎาคม): เราคาดว่า F&L จะทยอยปรับดีขึ้นเป็น +1% cFX ซึ่งเป็นการเติบโตเป็นบวกครั้งแรกในรอบ 7\n\nรูปที่ 2: เราคาดรายได้กลุ่มอุตสาหกรรมเติบโต +5% ใน 2Q26E หรือทยอยเร่งขึ้น 1ppt จาก 1Q\n\nที่มา: ประมาณการของ BofA Global Research, รายงานของบริษัท ค่าเฉลี่ยถ่วงน้ำหนักของบริษัทภายใต้ความคุ้มครอง: LVMH, Richemont, Brunello Cucinelli, Swatch, Dior, Kering,\n\nแต่แตกต่างกันมากในรายบริษัท เราสูงกว่าประมาณการตลาดสำหรับยอดขาย 2Q ของ\n\nรูป 3: เราคาดการเติบโตของรายได้ cFX ใน 2Q26 สูงกว่าประมาณการตลาด 1ppt\n\nรายได้ 2Q25 ภาคส่วน Richemont Hermes LVMH - F&L Prada Zegna Brunello Cucinelli\n\nในระดับกลุ่ม เราคาดรายได้ออร์แกนิกของ LVMH เติบโต +2% YoY ใน 2Q26\n\nประมาณการ BofA เทียบกับตลาดสำหรับผลประกอบการ LVMH ช่วง 1H ปี 26\n\nรูปที่ 45: เราคาดรายได้กลุ่ม LVMH เติบโต +2% cFX ใน 2Q26 โดยแผนก\n\nประมาณการยอดขาย LVMH 2Q 26: BofA เทียบกับตลาด (Dec YE)","item_