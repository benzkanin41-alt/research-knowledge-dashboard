ก่ ตรัง 62%, กระบี่ 75% และสมุย 34% ในปี 2568\n\n▪ แนวโน้มก าไร 2Q69F คาดอ่อนตัวทั้ง YoY และ QoQ แม้รายได้มีโอกาส เติบโต แต่ถูกหักล้างด้วยต้นทุน\n\nRATING WBUY TARGET 7.50 UPSIDE +28% TICKER WPH\n\nRATING คือ “ค าแนะน าด้านปัจจัยพื้นฐาน” พิจารณาจากอัตราผลตอบแทนที่คาดหวังในระยะ 12 เดือนข้างหน้า โดยอิงส่วนต่างของราคาหุ้น\n\nทั้งนี้ ค าแนะน า ACTION ทั้ง 9 กลยุทธ์ มีความหมายดังนี้ SBUY=STRONG BUY=ราคาหุ้นต ่ากว่ามูลค่ามาก และราคามีแนวโน้มขึ้น ควรเข้า\n\nซื้อทันที, BUY=ราคาใกล้จะเต็มมูลค่า แต่ยังมีแนวโน้มปรับตัวขึ้นต่อ, TBUY= TRADING BUY=ราคาอยู่ในระดับแพง แต่มีโอกาสที่จะปรับขึ้น\n\nต่อได้ แนะน าแค่ซื้อเก็งก าไร, ADD=ราคาอยู่ต ่ากว่ามูลค่ามาก แต่ยังมีแนวโน้มทรง สามารถทยอยซื้อสะสมได้, WBUY=WEAK BUY=ราคา\n\nการลงทุน, SELL=ราคาใกล้เต็มมูลค่า และมีแนวโน้มลง แนะน าขาย, SWITCH=ราคาเกินมูลค่าและมีแนวโน้มลง แนะน าให้เปลี่ยนตัวเล่น","item_type":"ผลประกอบการ","line_start":1,"line_end":460,"confidence":0.98,"source_name":"WPH_LHS_2026-05-26__7afa3f16.txt","stock_scope":"source","scope_label":"เฉพาะ WPH","cited_sources":[]},{"id":3018,"stock_id":476,"source_document_id":1245,"report_date":"2026-05-13","heading":"WPH","content":"Chart Perspective Morning กล่าวถึง WPH ในเชิงเทคนิค ข้อมูลที่ extract ได้ยังไม่พอสำหรับ thesis พื้นฐานโรงพยาบาล ต้องตรวจรายได้ผู้ป่วยไทย/ต่างชาติ, margin, utilization และฤดูกาลท่องเที่ยวภูเก็ตก่อนตัดสินใจลงทุน","item_type":"การดำเนินงาน","line_start":261,"line_end":264,"confidence":0.98,"source_name":"research_summary.md","stock_scope":"excerpt","scope_label":"เฉพาะ WPH","cited_sources":[]}],"sources":[{"name":"WPH_LHS_2026-05-26__7afa3f16.txt","report_date":"2026-05-26","item_count":1,"first_line":1,"last_line":460},{"name":"research_summary.md","report_date":"2026-05-13","item_count":1,"first_line":261,"last_line":264}],"metric_groups":[{"key":"FY-2027:revenue","period_key":"FY-2027","period_kind":"year","period_label":"ปี 2570F","period_year":2027,"period_quarter":5,"metric_code":"revenue","metric_label":"รายได้","scale":"million","currency":"THB","unit_l