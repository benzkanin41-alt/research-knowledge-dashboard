":null,"source_name":"Moderna_Offshore_Playbook_260515__568310ae.txt"}],"comparisons":[],"knowledge":[{"id":18308,"stock_id":500,"source_document_id":6194,"report_date":"2026-08-21","heading":"MODERNA — บทวิเคราะห์รายบริษัท: Moderna_Offshore_Playbook_260821","content":"❖ ผลทดลองวัคซีนรักษำมะเร็ง Phase 3 ออกมำในทิศทำงบวก : Moderna และ Merck ประกาศผลส าเร็จในการทดลองวัคซีน\n\n❖ รำยได้หลักมำจำกวัคซีนโควิด -19 : ณ สิ้น 2Q26 Moderna มีรายได้จากผลิตภัณฑ์รวม 94 ล้าน\n\n❖ ปัจจัยเสี่ยง: Moderna พึ่งพาวัคซีนโควิด-19 เป็นรายได้หลักหากความต้องการวัคซีนเข็มกระตุ้นลดลง\n\nModerna's Revenue EXPOSURE 2Q26 Moderna's EXPOSURE 2Q26\n\n❖ Moderna แจ้งงบ 2Q26 ดีกว่ำคำดทั้งรำยได้และขำดทุนต่อหุ้น : Moderna รายงานรายได้รวม 2Q26\n\nที่ 145 ล้านดอลลาร์ +2.1%y-y สูงกว่า Consensus คาดราว 41% ขณะที่รายได้จากผลิตภัณฑ์อยู่ที่ 94\n\n❖ 2026F เป็นปีแห่งกำรฟื้นตัวของรำยได้และลด Cash Burn: หลังประกาศงบ 2Q26 Moderna ยังคง\n\nเป้ารายได้ปี 2026F จะเติบโต 10%y-y โดยบริษัทคาดรายได้ 2H26 จะเร่งตัวขึ้น และประมาณ 55% ของ\n\nModerna จะมีผลขาดทุนสุทธิในปีนี้ประมาณ 3,432 ล้านดอลลาร์ แย่ลงจากปี 2025 ที่ขาดทุน 2,822\n\nล้านดอลลาร์ อย่างไรก็ตาม จุดบวกคือ Moderna ปรับลดประมาณการ Cost of Sales ปี 2026 เหลือ","item_type":"ผลประกอบการ","line_start":1,"line_end":324,"confidence":0.98,"source_name":"Moderna_Offshore_Playbook_260821__c3bc57f4.txt","stock_scope":"source","scope_label":"เฉพาะ MODERNA","cited_sources":[]},{"id":3571,"stock_id":500,"source_document_id":1487,"report_date":"2026-05-15","heading":"MODERNA — Moderna_Offshore_Playbook_260515__568310ae","content":"ส าคัญที่กระตุ้นความสนใจกับ Moderna เนื่องจากบริษัทได้พัฒนาวัคซีนป้องกันไวรัสชนิดนี้ร่วมกับกองทัพสหรัฐฯ และสถาบัน\n\n❖ Valuation & Action: ราคาหุ้น Moderna เข้าสู่โหมดขาลงนับตั้งแต่วิกฤติโควิด-19 สิ้นสุดลง โดยราคาหุ้นท าจุดสูงสุดที่ระดับ\n\nModerna เนื่องจากเป็นบริษัทที่มีความเชี่ยวชาญและเป็นผู้น าในเทคโนโลยี mRNA ซึ่งสามารถแก้รหัสพันธุกรรมและพัฒนาเป็น\n\n❖ รำยได้หลักมำจำกวัคซีนโควิด-19 (Spikevax): Moderna มีรายได้หลักมาจากยอดขายวัคซีนป้องกัน\n\n❖ ปัจจัยเสี่ยง: Moderna พึ่งพาวัคซีนโควิด-19 เป็นรายได้หลักหากความต้องการวัคซีนเข็มกระตุ้นลดลง\n\nModerna's Revenue EXPOSURE 2025 Moderna's EXPOSURE 2025\n\n❖ 1Q26 งบยังขำดทุน: Moderna รายงานผลประกอบการ 1Q26 มีรายได้รวมที่ 389 ล้านดอลลาร์สหรัฐ\n\n❖ 2026F รำยได้กลับมำโตแต่งบรวมยังขำดทุน : ผลประกอบการของ Moderna ในปีนี้ (2026F) คาดว่า\n\nพันล้านดอลลาร์ +7%y-y (Moderna คาดการณ์ +10%y-y) โดยมีแรงขับเคลื่อนหลักจากการท าสัญญา\n\nงบของ Moderna ในปีนี้จะขาดทุนสุทธิ 3.4 พันล้านดอลลาร์ สูงขึ้นจากขาดทุนสุทธิ 2.8 พันล้านดอลลาร์","item_type":"ผลประกอบการ","line_start":1,"line_end":316,"confidence":0.98,"source_name":"Moderna_Offshore_Playbook_260515__568310ae.txt","stock_scope":"source","scope_label":"เฉพาะ MODERNA","cited_sources":[]}],"sources":[{"name":"Moderna_Offshore_Playbook_260821__c3bc57f4.txt","report_date":"2026-08-21","item_count":1,"first_line":1,"last_line":324},{"name":"Moderna_Offshore_Playbook_260515__568310ae.txt","report_date":"2026-05-15","item_count":1,"first_line":1,"last_line":316}],"metric_groups":[{"key":"Q2-2025:gpm","period_key":"Q2-2025","period_kind":"quarter","period_label":"2Q68","period_year":2025,"period_quarter":2,"metric_code":"gpm","metric_label":"อัตรากำไรขั้นต้น (GPM)","scale":"percent","currency":null,"unit_label":"%","status":"reported","actual":{"value":35.9,"date":"2026-08-21","source_name":"Moderna_Offshore_Playbook_260821__c3bc57f4.txt","supporting_sources":1,"reasons":["GPM เพิ่มขึ้นเป็น 35.9% จาก 16.2% ใน 2Q25 จากต้นทุนการผลิตที่ลดลง 22%y-y สะท้อนการเพิ่ม"],"sources":[{"analyst":"ไม่ระบุสำนัก","source_name":"Moderna_Offshore_Playbook_260821__c3bc57f4.txt","date":"2026-08-21"}],"currency":null,"scale":"percent"},"estimate_count":0,"estimate_median":null,"estimate_min":null,"estimate_max":null,"rows":[],"coverage_engine":"all-company-v17-final-quality","included_brokers":[],"mixed_currency":false,"coverage_release":"2026-07-23-v47-actual-release-guard","exact_reconciliation":true,"fundamental_integrity":true,"semantic_quarantine_count":0,"semant