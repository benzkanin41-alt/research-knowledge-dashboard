 ความเสี่ยง Dilution เพิ่มขึ้นจากการออกหุ้นกู้ใหม่ ราคาเป้าหมาย NBIS US\n\nคาดการณ์และอัตราส่วนทางการเงินที่ส าคัญ\n\nSales (USD mn) 118 530 3,896 12,972 20,297\n\nNet profit (USD mn) (247) (447) (1,082) (934) (107)\n\nทิสโก้ไม่ต้องรับผิดต่อความเสียหายใด ๆ ที่เกิดขึ้นโดยตรงหรือเป็นผลจากการใช้เนื้อหาหรือรายงานฉบับ นี้ บทความ\n\nบทวิเคราะห์ และการคาดหมายทั้งหลายที่ปรากฎอยู่ในรายงานนี้เป็นการน าไปใช้โดยผู้ใช้ยอมรับความเสี่ยงและเป็นดุลย","item_type":"ประมาณการ","line_start":1,"line_end":184,"confidence":0.98,"source_name":"NBIS_20.08.69__4d20d841.txt","stock_scope":"source","scope_label":"เฉพาะ NBIS","cited_sources":[]},{"id":15838,"stock_id":880,"source_document_id":5224,"report_date":"2026-08-13","heading":"NBIS — บทวิเคราะห์รายบริษัท: NBIS_13.08.69_2","content":"รายได้และก าไรดีกว่าตลาดคาด การด าเนินงานแข็งแกร่งตาม Capacity ที่เพิ่มขึ้น\n\nน้อยกว่าที่ตลาดคาดอย่างมาก ส่งผลให้ราคาหุ้นปรับตัวขึ้น +34% วันต่อวันสู่ระดับ\n\nสูงขึ้นอีก 15% สะท้อนความต้องการประมวลผลระดับสูงที่สูงขึ้นมาก ช่วยหนุนรายได้และ\n\nอัตราก าไร รวมถึงใน 2H27 ที่จะเริ่มรับรู้รายได้จาก Vera Rubin NVL72 เป็นอีกหนึ่งปัจจัย\n\n• บริษัทคงประมาณการ Guidance เดิม Annualized Recurring Revenue US$7-9bn\n\nอยู่ที่ US$9bn คิดเป็น 40% ของ CAPEX ที่เราประมาณการในปีนี้ที่ US$23bn บริษัทคาดว่าแหล่งเงินทุนจะมาจากการจัดหาโดยไม่\n\n• นอกจากนี้เหตุผลที่หุ้นปรับตัวขึ้นอาจจะมาจาก Sentiment ที่ดีขึ้น หลังผลประกอบการบริษัท Neocloud ดีกว่าคาดและปรับ\n\nโดยตรงซึ่งประกาศผลประกอบการ 2Q26 ดีกว่าคาดเช่นเดียวกัน และปรับ Guidance FY2026 เพิ่มขึ้นดังนี้ รายได้ US$12.4-\n\n13.2bn จาก US$12-13bn, Adjusted Operating Income US$960-1,150mn จาก US$900-1,100mn, CAPEX US$35-39bn\n\nCRWV (คู่แข่ง) ปรับ Guidance เพิ่มขึ้นส าหรับ FY2026 สะท้อน Demand ของอุตสาหกรรมที่แข็งแกร่ง","item_type":"ผลประกอบการ","line_start":1,"line_end":227,"confidence":0.98,"source_name":"NBIS_13.08.69_2__28ef9a21.txt","stock_scope":"source","scope_label":"เฉพาะ NBIS","cited_sources":[]},{"id":15839,"stock_id":880,"source_document_id":5225,"report_date":"2026-08-13","heading":"NBIS — บทวิเคราะห์รายบริษัท: NBIS_13.08.69","content":"รายได้และก าไรดีกว่าตลาดคาด การด าเนินงานแข็งแกร่งตาม Capacity ที่เพิ่มขึ้น\n\nน้อยกว่าที่ตลาดคาดอย่างมาก ส่งผลให้ราคาหุ้นปรับตัวขึ้น +34% วันต่อวันสู่ระดับ\n\nสูงขึ้นอีก 15% สะท้อนความต้องการประมวลผลระดับสูงที่สูงขึ้นมาก ช่วยหนุนรายได้และ\n\nอัตราก าไร รวมถึงใน 2H27 ที่จะเริ่มรับรู้รายได้จาก Vera Rubin NVL72 เป็นอีกหนึ่งปัจจัย\n\n• บริษัทคงประมาณการ Guidance เดิม Annualized Recurring Revenue US$7-9bn\n\nอยู่ที่ US$9bn คิดเป็น 40% ของ CAPEX ที่เราประมาณการในปีนี้ที่ US$23bn บริษัทคาดว่าแหล่งเงินทุนจะมาจากการจัดหาโดยไม่\n\n• นอกจากนี้เหตุผลที่หุ้นปรับตัวขึ้นอาจจะมาจาก Sentiment ที่ดีขึ้น หลังผลประกอบการบริษัท Neocloud ดีกว่าคาดและปรับ\n\nโดยตรงซึ่งประกาศผลประกอบการ 2Q26 ดีกว่าคาดเช่นเดียวกัน และปรับ Guidance FY2026 เพิ่มขึ้นดังนี้ รายได้ US$12.4-\n\n13.2bn จาก US$12-13bn, Adjusted Operating Income US$960-1,150mn จาก US$900-1,100mn, CAPEX US$35-39bn\n\nCRWV (คู่แข่ง) ปรับ Guidance เพิ่มขึ้นส าหรับ FY2026 สะท้อน Demand ของอุตสาหกรรมที่แข็งแกร่ง","item_type":"ผลประกอบการ","line_start":1,"line_end":227,"confidence":0.98,"source_name":"NBIS_13.08.69__e9582767.txt","stock_scope":"source","scope_label":"เฉพาะ NBIS","cited_sources":[]}],"sources":[{"name":"NBIS_20.08.69__4d20d841.txt","report_date":"2026-08-20","item_count":1,"first_line":1,"last_line":184},{"name":"NBIS_13.08.69_2__28ef9a21.txt","report_date":"2026-08-13","item_count":1,"first_line":1,"last_line":227},{"name":"NBIS_13.08.69__e9582767.txt","report_date":"2026-08-13","item_count":1,"first_line":1,"last_line":227}],"metric_groups":[{"key":"FY-2028:revenue","period_key":"FY-2028","period_kind":"year","period_label":"ปี 2571F","period_year":2028,"period_quarter":5,"metric_code":"revenue","metric_label":"รายได้","scale":"million","currency":"USD","unit_label":"USD ล้าน","status":"awaiting","actual":null,"rows":[{"analyst":"TISCO Securities","estimate":20297.0,"estimate_low":20297.0,"estimate_high":20297.0,"estimate_date":"2026-08-20","source_name":"