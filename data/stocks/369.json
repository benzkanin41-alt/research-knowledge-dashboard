ูรณ์ของข้อมูลข่าวสาร และมิได้รับประกันราคา ผลตอบแทน หรือความเสียหายจากการลงทุน หรือจาก\n\nลงทุนเองในการตัดสินใจลงทุนในแต่ละกรณี นอกจากนี้ ข้อมูลข่าวสาร หรือผลการด าเนินงานในอดีตที่แสดงใน\n\nเสียหายใดๆ (ไม่ว่าโดยตรงหรือโดยอ้อม และไม่ว่าจะคาดเห็นได้หรือไม่ก็ตาม) ซึ่งเกิดจากการใช้เอกสารฉบับนี้ไม่ว่า","item_type":"ประมาณการ","line_start":1,"line_end":278,"confidence":0.98,"source_name":"L_I_ETFs_-_2X01BSET50_TF_1H_EMA_50_-BLS-30_Jun_2569__012b2d3e.txt","stock_scope":"source","scope_label":"เฉพาะ TF","cited_sources":[]}],"sources":[{"name":"260921_Soft_com_QC__3de99594.txt","report_date":"2026-09-21","item_count":1,"first_line":173,"last_line":181},{"name":"L_I_ETFs_-_2X01BSET50_TF_1H_EMA_50_-BLS-30_Jun_2569__012b2d3e.txt","report_date":"2026-06-30","item_count":1,"first_line":1,"last_line":278}],"metric_groups":[],"quote":{"available":false,"symbol":"TF","source_url":"https://www.set.or.th/en/market/product/stock/quote/TF/price","source_name":"ตลาดหลักทรัพย์แห่งประเทศไทย (SET)","fetched_at":"2026-09-25T23:15:38+07:00","stale":false,"error":"SET ไม่มีราคาสำหรับสัญลักษณ์นี้ หรือเชื่อมต่อหน้า SET ไม่สำเร็จ"},"view_rules":{"stock_first":true,"macro_excluded":true,"deduplicated":true,"quote_async":true},"_v4_finalized":true,"estimate_coverage_release":"2026-07-23-v17-final-all-company","visible_forecast_guard_release":"2026-08-08-v58.2-new-source-scope-resolution","visible_forecast_policy":{"sector_aggregate_company_estimate_forbidden":true,"one_visible_row_per_broker_metric_period":true,"applied_after_lower_layer_cache":true},"broker_attribution_repairs_v59":0,"preview_actual_guard_release":"2026-08-15-v59.16-terminal-broker-review-closure","preview_actual_policy":{"recent_actual_requires_release_language_owning_period_metric_value":true,"preview_value_returns_to_broker_estimates":true,"grossly_misbound_result_amount_is_corrected":true,"result_owned_visible_row_can_recover_actual":true,"terminal_after_lower_cache":true,"persistent_terminal_detail_cache":true,"per_stock_sign