ock โดยเฉพาะกลุ่ม Healthcare นักลงทุนที่สนใจกลุ่มธุรกิจ\n\nเครื่องมือแพทย์ที่ราคาไม่แพงและมีปันผลสม ่าเสมอ สามารถเข้าลงทุนในหุ้นของบริษัท Medtronic (MDT) ผ่านทาง Krungsri iGlobal\n\nโดย Bloomberg Consensus ประเมินราคาเป้าหมายของหุ้น Medtronic (MDT) ปี 2027 กรณี Base case ที่ราคา 96.85 USD/หุ้น\n\n❖ รำยได้หลักมำจำกอุปกรณ์รักษำโรคหัวใจและหลอดเลือด : Medtronic มีรายได้กระจายตัวในหลาย\n\nMedtronic's Revenue EXPOSURE 2026 Medtronic's EXPOSURE 2026\n\n❖ ปี 2026 รำยได้ท ำสถิติสูงสุดในรอบ 10 ปี Medtronic รายงานงบ 4QFY26 (ม.ค.-เม.ย.26) มีรายได้","item_type":"ผลประกอบการ","line_start":1,"line_end":352,"confidence":0.98,"source_name":"Medtronic_Offshore_Playbook__75b2d5bb.txt","stock_scope":"source","scope_label":"เฉพาะ MEDTRONIC","cited_sources":[]}],"sources":[{"name":"Medtronic_Offshore_Playbook__75b2d5bb.txt","report_date":"2026-07-03","item_count":1,"first_line":1,"last_line":352}],"metric_groups":[],"quote":{"available":false,"symbol":"MEDTRONIC","source_url":"https://www.set.or.th/en/market/product/stock/quote/MEDTRONIC/price","source_name":"ตลาดหลักทรัพย์แห่งประเทศไทย (SET)","fetched_at":"2026-09-02T12:22:43+07:00","stale":false,"error":"SET ไม่มีราคาสำหรับสัญลักษณ์นี้ หรือเชื่อมต่อหน้า SET ไม่สำเร็จ"},"view_rules":{"stock_first":true,"macro_excluded":true,"deduplicated":true,"quote_async":true},"_v4_finalized":true,"estimate_coverage_release":"2026-07-23-v17-final-all-company","visible_forecast_guard_release":"2026-08-08-v58.2-new-source-scope-resolution","visible_forecast_policy":{"sector_aggregate_company_estimate_forbidden":true,"one_visible_row_per_broker_metric_period":true,"applied_after_lower_layer_cache":true},"broker_attribution_repairs_v59":0,"preview_actual_guard_release":"2026-08-15-v59.16-terminal-broker-review-closure","preview_actual_policy":{"recent_actual_requires_release_language_owning_period_metric_value":true,"preview_value_returns_to_broker_estimates":true,"grossly_misbound_result_amount_is_corrected":true,"result_owned_visible_row_can_recover_ac