อกาศและความคาดหวังให้กับหุ้น Novo นักลงทุนที่เน้นลงทุน\n\nNovo Nordisk (NOVO) เป็นบริษัทยาชั้นน าจากประเทศเดนมาร์กมีรายได้หลักจากธุรกิจโรค\n\nทั้งนี้ ในส่วนรายได้ตามผลิตภัณฑ์ NOVO ถือว่ามีความกระจุกตัวมากกว่าคู่แข่ง ในส่วน Eli\n\nมากจึงมีโอกาสสร้างยอดขายเพิ่มขึ้นแบบรวดเร็วให้กับผู้ประกอบการในกลุ่มยาลดความอ้วนโดยเฉพาะ\n\n❖ Novo ปรับเพิ่มคาดการณ์รายได้และก าไรปีนี้: เพื่อสะท้อนผลประกอบการที่ออกมาดีใน 1Q26 Novo ได้\n\nปรับเพิ่มคาดการณ์ยอดขายและก าไรปีนี้ขึ้นเป็น -4% ถึง -12% แม้ตัวเลขจะยังติดลบแต่ดีขึ้นเมื่อเทียบกับ\n\nส่วน Bloomberg Consensus คาดก าไรสุทธิ Novo ปีนี้ที่ 95,400 ล้านโครนเดนมาร์ก -7.6%y-y","item_type":"ผลประกอบการ","line_start":1,"line_end":362,"confidence":0.98,"source_name":"NOVO_Offshore_Playbook_260508__65f7ce2e.txt","stock_scope":"source","scope_label":"เฉพาะ NOVO","cited_sources":[]}],"sources":[{"name":"NOVO_Offshore_Playbook_260508__65f7ce2e.txt","report_date":"2026-05-08","item_count":1,"first_line":1,"last_line":362}],"metric_groups":[],"quote":{"available":false,"symbol":"NOVO","source_url":"https://www.set.or.th/en/market/product/stock/quote/NOVO/price","source_name":"ตลาดหลักทรัพย์แห่งประเทศไทย (SET)","fetched_at":"2026-09-02T12:22:47+07:00","stale":false,"error":"SET ไม่มีราคาสำหรับสัญลักษณ์นี้ หรือเชื่อมต่อหน้า SET ไม่สำเร็จ"},"view_rules":{"stock_first":true,"macro_excluded":true,"deduplicated":true,"quote_async":true},"_v4_finalized":true,"estimate_coverage_release":"2026-07-23-v17-final-all-company","visible_forecast_guard_release":"2026-08-08-v58.2-new-source-scope-resolution","visible_forecast_policy":{"sector_aggregate_company_estimate_forbidden":true,"one_visible_row_per_broker_metric_period":true,"applied_after_lower_layer_cache":true},"broker_attribution_repairs_v59":0,"preview_actual_guard_release":"2026-08-15-v59.16-terminal-broker-review-closure","preview_actual_policy":{"recent_actual_requires_release_language_owning_period_metric_value":true,"preview_value_returns_to_broker_estimates":true,"grossly_misbound_result_amount_is_c