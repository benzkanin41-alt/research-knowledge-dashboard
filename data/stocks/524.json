cs) คล้ายกับช่วง Covid-19 ระบาด คาดปัจจัยทั้งหมดนี้จะยังหนุนให้ราคา\n\niGlobal โดย Bloomberg Consensus ประเมินราคาเป้าหมายของหุ้น Roche Holding AG (ROG SW) ปี 2026 กรณี Base Case ที่\n\nRoche ยังประกอบธุรกิจในกลุ่มเครื่องมือตรวจวินิจฉัยโรค (Diagnostics) ซึ่งปัจจุบันมียอดขายเป็น\n\n❖ รายได้หลักมาจากกลุ่มยา : Roche มีโครงสร้างรายได้มาจาก 2 กุลุ่มธุรกิจ คือ 1) รายได้จากกลุ่ม\n\nROCHE's Revenue EXPOSURE 2025 ROCHE's EXPOSURE 2025\n\n❖ ยาใหม่ท ายอดขายเร่งขึ้นชดเชยยาเก่าที่หมดสิทธิบัตร : Roche Holding รายงานยอดขายรวม\n\nสาธารณสุขในประเทศ) โดยปีนี้ Consensus คาดรายได้จากธุรกิจ Diagnostics จะเพิ่มขึ้น 4%-6%y-y\n\nสูงขึ้นเมื่อเทียบกับ 1Q26 ที่ +3%y-y ส่วน Operating Margin คาดว่าจะฟื้นตัวสู่ระดับ 34%-35% จาก","item_type":"ผลประกอบการ","line_start":1,"line_end":365,"confidence":0.98,"source_name":"ROCHE_Offshore_Playbook_260520__6b5cb9a7.txt","stock_scope":"source","scope_label":"เฉพาะ ROCHE","cited_sources":[]}],"sources":[{"name":"ROCHE_Offshore_Playbook_260520__6b5cb9a7.txt","report_date":"2026-05-20","item_count":1,"first_line":1,"last_line":365}],"metric_groups":[],"quote":{"available":false,"symbol":"ROCHE","source_url":"https://www.set.or.th/en/market/product/stock/quote/ROCHE/price","source_name":"ตลาดหลักทรัพย์แห่งประเทศไทย (SET)","fetched_at":"2026-09-02T12:22:47+07:00","stale":false,"error":"SET ไม่มีราคาสำหรับสัญลักษณ์นี้ หรือเชื่อมต่อหน้า SET ไม่สำเร็จ"},"view_rules":{"stock_first":true,"macro_excluded":true,"deduplicated":true,"quote_async":true},"_v4_finalized":true,"estimate_coverage_release":"2026-07-23-v17-final-all-company","visible_forecast_guard_release":"2026-08-08-v58.2-new-source-scope-resolution","visible_forecast_policy":{"sector_aggregate_company_estimate_forbidden":true,"one_visible_row_per_broker_metric_period":true,"applied_after_lower_layer_cache":true},"broker_attribution_repairs_v59":0,"preview_actual_guard_release":"2026-08-15-v59.16-terminal-broker-review-closure","preview_actual_policy":{"recent_actual_requires_release_language_owning_period